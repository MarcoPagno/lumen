{
  "name": "lumen",
  "version": "1.0.0",
  "description": "Implementation of Lumen website",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run lint:prettier:check && npm run lint:eslint:check  && npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint --fix .",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie": "1.1.1",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "next-connect": "1.0.0",
    "node-html-parser": "7.1.0",
    "node-pg-migrate": "8.0.4",
    "nodemailer": "8.0.7",
    "pg": "8.20.0",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "4.8.0",
    "swr": "2.4.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/css": "1.0.0",
    "@eslint/js": "9.39.4",
    "@eslint/json": "1.1.0",
    "@eslint/markdown": "7.5.1",
    "@faker-js/faker": "10.4.0",
    "@tailwindcss/postcss": "4.3.0",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "17.4.2",
    "dotenv-expand": "12.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.2",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "prettier": "3.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  },
  "imports": {
    "#components/*": "./src/components/*.jsx",
    "#lib/*": "./src/lib/*.js"
  }
}
