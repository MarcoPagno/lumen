{
  "name": "lumen",
  "version": "1.0.0",
  "description": "Implementation of Lumen website",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv": "17.4.2",
    "next": "16.2.3",
    "next-connect": "1.0.0",
    "node-pg-migrate": "8.0.4",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "prettier": "3.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
